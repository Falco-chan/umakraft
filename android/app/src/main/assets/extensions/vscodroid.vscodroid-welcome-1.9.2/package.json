{
  "name": "vscodroid-welcome",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "1.9.2",
  "publisher": "vscodroid",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "configuration": {
      "title": "VSCodroid",
      "properties": {
        "vscodroid.layout.autoHideSideBar": {
          "type": "string",
          "enum": [
            "auto",
            "on",
            "off"
          ],
          "default": "auto",
          "description": "%config.layout.autoHideSideBar%"
        }
      }
    },
    "configurationDefaults": {
      "workbench.startupEditor": "none",
      "workbench.colorTheme": "Light Modern",
      "workbench.colorCustomizations": {
        "activityBar.background": "#ffe3ef",
        "activityBar.foreground": "#9c1553",
        "activityBar.activeBorder": "#d6246e",
        "activityBarBadge.background": "#d6246e",
        "sideBar.background": "#fff5f9",
        "sideBarSectionHeader.background": "#ffe3ef",
        "editor.background": "#ffffff",
        "editorGroupHeader.tabsBackground": "#fff5f9",
        "tab.activeBorderTop": "#d6246e",
        "titleBar.activeBackground": "#ffe3ef",
        "statusBar.background": "#d6246e",
        "statusBar.foreground": "#ffffff",
        "button.background": "#d6246e",
        "button.hoverBackground": "#b81d5c",
        "focusBorder": "#d6246e",
        "textLink.foreground": "#b81d5c",
        "list.activeSelectionBackground": "#ffd0e3",
        "list.activeSelectionForeground": "#3a1a28",
        "list.hoverBackground": "#ffeaf3",
        "input.border": "#f3a6c4",
        "terminal.background": "#fffafc",
        "panel.background": "#fffafc"
      },
      "workbench.sash.size": 20,
      "workbench.activityBar.compact": true,
      "workbench.secondarySideBar.defaultVisibility": "hidden",
      "editor.wordWrap": "on",
      "editor.minimap.enabled": false,
      "breadcrumbs.enabled": false,
      "editor.stickyScroll.enabled": false,
      "workbench.layoutControl.enabled": false,
      "terminal.integrated.fontSize": 15,
      "editor.fontSize": 16,
      "workbench.activityBar.location": "bottom",
      "workbench.editor.showTabs": "single",
      "workbench.panel.opensMaximized": "always",
      "terminal.integrated.stickyScroll.enabled": false
    },
    "commands": [
      {
        "command": "vscodroid.welcome.open",
        "title": "%command.welcome.open%"
      },
      {
        "command": "vscodroid.welcome.toolsDismissed",
        "title": "%command.welcome.toolsDismissed%"
      }
    ],
    "walkthroughs": [
      {
        "id": "vscodroid.welcome",
        "title": "%walkthrough.title%",
        "description": "%walkthrough.description%",
        "steps": [
          {
            "id": "theme",
            "title": "%walkthrough.theme.title%",
            "description": "%walkthrough.theme.description%",
            "media": {
              "svg": "media/theme.svg"
            },
            "completionEvents": [
              "onSettingChanged:workbench.colorTheme"
            ]
          },
          {
            "id": "folder",
            "title": "%walkthrough.folder.title%",
            "description": "%walkthrough.folder.description%",
            "media": {
              "svg": "media/folder.svg"
            },
            "completionEvents": [
              "onCommand:vscodroid.openFolderFromDevice"
            ]
          },
          {
            "id": "run",
            "title": "%walkthrough.run.title%",
            "description": "%walkthrough.run.description%",
            "media": {
              "svg": "media/run.svg"
            },
            "completionEvents": [
              "onStepSelected"
            ]
          },
          {
            "id": "tools",
            "title": "%walkthrough.tools.title%",
            "description": "%walkthrough.tools.description%",
            "media": {
              "svg": "media/tools.svg"
            },
            "completionEvents": [
              "onCommand:vscodroid.welcome.toolsDismissed"
            ]
          },
          {
            "id": "terminal",
            "title": "%walkthrough.terminal.title%",
            "description": "%walkthrough.terminal.description%",
            "media": {
              "svg": "media/terminal.svg"
            },
            "completionEvents": [
              "onCommand:workbench.action.terminal.new"
            ]
          },
          {
            "id": "extensions",
            "title": "%walkthrough.extensions.title%",
            "description": "%walkthrough.extensions.description%",
            "media": {
              "svg": "media/extensions.svg"
            },
            "completionEvents": [
              "onCommand:workbench.view.extensions"
            ]
          }
        ]
      }
    ]
  }
}
